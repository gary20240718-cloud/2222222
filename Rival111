FlyBtn.MouseButton1Click:Connect(function()
    flyEnabled = not flyEnabled
    FlyBtn.Text = "飛天 (穿牆): " .. (flyEnabled and "開啟" or "關閉")
    FlyBtn.BackgroundColor3 = flyEnabled and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(50, 50, 50)
    UpBtn.Visible = flyEnabled
    DownBtn.Visible = flyEnabled

    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")

    if hrp and humanoid then
        if flyEnabled then
            humanoid.PlatformStand = true
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)

            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
            local bv = Instance.new("BodyVelocity")
            bv.Name = "HackFly"
            bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = hrp
        else
            local rayOrigin = hrp.Position
            local rayDirection = Vector3.new(0, -1000, 0)
            local raycastParams = RaycastParams.new()
            raycastParams.FilterDescendantsInstances = {char}
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude

            local rayResult = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
            if rayResult then
                hrp.CFrame = CFrame.new(rayResult.Position + Vector3.new(0, 3.5, 0))
            end

            if hrp:FindFirstChild("HackFly") then hrp.HackFly:Destroy() end
            humanoid.PlatformStand = false
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then part.CanCollide = true end
            end
            task.delay(3, function()
                if humanoid then
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, true)
                end
            end)
        end
    end
end)


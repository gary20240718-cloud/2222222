-- 4. 即時運算迴圈
-- ==========================================
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChild("Humanoid")

    -- 人物旋轉 (Spinbot)
    if spinEnabled and hrp then
        hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(30), 0)
    end

    -- 防掉圖
    if flyEnabled and hrp then
        if hrp.Position.Y < -50 then
            hrp.CFrame = CFrame.new(hrp.Position.X, 50, hrp.Position.Z)
        end
    end

    -- 飛天控制
    if flyEnabled and hrp and humanoid then
        local bv = hrp:FindFirstChild("HackFly")
        if bv then
            local moveDir = humanoid.MoveDirection * 60
            if isGoingUp then moveDir = moveDir + Vector3.new(0, 50, 0) end
            if isGoingDown then moveDir = moveDir - Vector3.new(0, 80, 0) end

            if humanoid.MoveDirection.Magnitude == 0 and not isGoingUp and not isGoingDown then
                bv.Velocity = Vector3.new(0, 2, 0)
            else
                bv.Velocity = moveDir
            end
        end
    end

    -- 透視與敵人收集
    local activePlayers = {}
    local enemies = {}

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local pChar = player.Character
            local pHumanoid = pChar:FindFirstChildOfClass("Humanoid")
            local pHead = pChar:FindFirstChild("Head")
            local pRoot = pChar:FindFirstChild("HumanoidRootPart")
            
            if pHumanoid and pHumanoid.Health > 0 and pHead and pRoot then
                activePlayers[player.UserId] = true
                local dist = math.floor((Camera.CFrame.Position - pRoot.Position).Magnitude)

                if dist <= 350 then
                    table.insert(enemies, pRoot)

                    if espEnabled then
                        local health = math.floor(pHumanoid.Health)
                        local headPos, onScreen = Camera:WorldToViewportPoint(pHead.Position + Vector3.new(0, 0.5, 0))

                        if onScreen then
                            local boxName = "ESP_Box_" .. player.UserId
                            local box = ScreenGui:FindFirstChild(boxName)
                            if not box then
                                box = Instance.new("Frame")
                                box.Name = boxName
                                box.BackgroundTransparency = 1
                                box.BorderSizePixel = 1
                                box.BorderColor3 = Color3.fromRGB(255, 0, 0)
                                box.Parent = ScreenGui
                            end
                            box.Visible = true
                            box.Size = UDim2.new(0, 40, 0, 60) 
                            box.Position = UDim2.new(0, headPos.X - 20, 0, headPos.Y - 10)

                            local tagName = "ESP_Tag_" .. player.UserId
                            local textTag = ScreenGui:FindFirstChild(tagName)
                            if not textTag then
                                textTag = Instance.new("TextLabel")
                                textTag.Name = tagName
                                textTag.BackgroundTransparency = 1
                                textTag.TextColor3 = Color3.fromRGB(255, 255, 255)
                                textTag.TextSize = 12
                                textTag.TextStrokeTransparency = 0
                                textTag.Font = Enum.Font.SourceSansBold
                                textTag.Size = UDim2.new(0, 150, 0, 30)
                                textTag.TextXAlignment = Enum.TextXAlignment.Center
                                textTag.Parent = ScreenGui
                            end
                            textTag.Visible = true
                            textTag.Text = player.Name .. " (" .. dist .. "m)\nHP: " .. health .. "\njiaNBB"
                            textTag.Position = UDim2.new(0, headPos.X - 75, 0, headPos.Y - 60)
                        else
                            local box = ScreenGui:FindFirstChild("ESP_Box_" .. player.UserId)
                            if box then box.Visible = false end
                            local tag = ScreenGui:FindFirstChild("ESP_Tag_" .. player.UserId)
                            if tag then tag.Visible = false end
                        end
                    end
                end
            end
        end
    end

    if espEnabled then
        for _, obj in pairs(ScreenGui:GetChildren()) do
            if obj.Name:match("ESP_") then
                local idStr = obj.Name:gsub("ESP_Box_", ""):gsub("ESP_Tag_", "")
                local id = tonumber(idStr)
                if not activePlayers[id] then obj:Destroy() end
            end
        end
    end

    -- 瞬移敵人身邊 (穿牆)
    if followEnabled and hrp then
        if #enemies > 0 and #enemies <= 5 then
            local closestRoot = nil
            local shortestDist = math.huge
            local myPos = hrp.Position

            for _, enemyRoot in pairs(enemies) do
                local dist = (myPos - enemyRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestRoot = enemyRoot
                end
            end

            if closestRoot and shortestDist > 4 then
                local bv = hrp:FindFirstChild("FollowVelocity")
                if not bv then
                    bv = Instance.new("BodyVelocity")
                    bv.Name = "FollowVelocity"
                    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
                    bv.Parent = hrp
                end
                
                for _, part in pairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
                
                local direction = (closestRoot.Position - hrp.Position)
                direction = Vector3.new(direction.X, 0, direction.Z).Unit
                local targetVel = (direction * 200) + Vector3.new(0, 2, 0)
                bv.Velocity = targetVel
            else
                if hrp:FindFirstChild("FollowVelocity") then hrp.FollowVelocity:Destroy() end
            end
        else
            if hrp:FindFirstChild("FollowVelocity") then hrp.FollowVelocity:Destroy() end
        end
    else
        if hrp and hrp:FindFirstChild("FollowVelocity") then hrp.FollowVelocity:Destroy() end
    end
end)

